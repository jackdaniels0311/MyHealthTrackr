POSTGRES_DB=myhealthtrackr_db
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Public domain pointing at this server for automatic HTTPS via Caddy.
DOMAIN=api-myhealthtrackr.duckdns.org

# Required in every environment. Use a unique random value of at least 32 characters.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=30
